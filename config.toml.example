[server]
host = "0.0.0.0"
port = 8080

[logging]
level = "info"

[tvdb]
api_key = "YOUR_API_KEY"
# Optional: subscriber PIN for extended access
# pin = "YOUR_PIN"
# Optional: 3-character ISO 639-2 language code for result translation.
# When set, name and overview are translated to this language (if available)
# and the overviews/translations maps are stripped from the response.
# Examples: "eng" (English), "deu" (German), "fra" (French), "spa" (Spanish)
# result_language = "eng"
